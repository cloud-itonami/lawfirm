{:paths ["src"]

 ;; langgraph carries the StateGraph runtime + checkpointer the actor pattern
 ;; is built on (CLAUDE.md Actors section).
 ;;
 ;; The kotoba-ui stack is the console's only UI dependency (skill
 ;; kotoba-uiux / ADR-2607122200): the app requires `kotoba-ui.core` and
 ;; `appkit.core` and nothing below them. shitsuke / liquid-glass-ui / css are
 ;; declared here at the top level *on purpose* — kotoba-ui's own deps.edn
 ;; references them by `:local/root` for sibling-checkout development, which
 ;; does not resolve for a git consumer. Top-level coordinates win over
 ;; transitive ones, so these four lines are what make a git dependency on the
 ;; design system resolvable at all.
 :deps {
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/langgraph.git"
         :git/sha "577a59a9d5eb3ef90b81342f4673973f481ff7f4"}

        ;; `lawfirm.projection` emits these types rather than ad-hoc maps, so
        ;; a host that already speaks the workspace does not have to translate
        ;; — and so the projection is checked by the same models the host
        ;; reads with. Both are portable `.cljc` with no network, no clock and
        ;; no filesystem; they add types, not authority.
        io.github.kotoba-lang/calendar
        {:git/url "https://github.com/kotoba-lang/calendar.git"
         :git/sha "2d9b9fc5efe80ea42afaa30bbdf8915fe4d9540f"}
        io.github.kotoba-lang/drive
        {:git/url "https://github.com/kotoba-lang/drive.git"
         :git/sha "31df8f6ac6013bc1844dc812c6cabc7c0b41e739"}

        ;; The fleet-shared verdict assembly + provenance rules. Not a
        ;; hand-copy: the same five lines existed in 376 governors here and one
        ;; had drifted (ADR-2607309100).
        io.github.kotoba-lang/governor
        {:git/url "https://github.com/kotoba-lang/governor.git"
         :git/sha "8df632b6610d30f6fef4edd9782cb1659bedb727"}

        io.github.kotoba-lang/kotoba-ui
        {:git/url "https://github.com/kotoba-lang/kotoba-ui.git"
         :git/sha "4167b3aa911690368bb47b61e825c47d3327bfac"}
        io.github.kotoba-lang/appkit
        {:git/url "https://github.com/kotoba-lang/appkit.git"
         :git/sha "03b1c5373817229060f3fac9e41e97775c320997"}
        io.github.kotoba-lang/shitsuke
        {:git/url "https://github.com/kotoba-lang/shitsuke.git"
         :git/sha "8820801bbf52d47a31be9521a193f9bc5359a39e"}
        io.github.kotoba-lang/liquid-glass-ui
        {:git/url "https://github.com/kotoba-lang/liquid-glass-ui.git"
         :git/sha "8bb2c4fa10c06e638e38e55bff1b7f36830f2766"}
        io.github.kotoba-lang/css
        {:git/url "https://github.com/kotoba-lang/css.git"
         :git/sha "7fc8167c4fb97a92b7c21545e6a92a86cc58a9ca"}
        io.github.kotoba-lang/html
        {:git/url "https://github.com/kotoba-lang/html.git"
         :git/sha "04606d97309fa377a20d18ee123e5db8f59ad127"}}

 :aliases
 {;; clj-kondo from deps (no binary); errors fail.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}

  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      ;; Test-time only. The console gates itself on the
                      ;; deterministic HIG/WCAG audit (ADR-2607132300) — an
                      ;; unmeasured page is theater.
                      io.github.kotoba-lang/design-quality
                      {:git/url "https://github.com/kotoba-lang/design-quality.git"
                       :git/sha "fb766e2f79c088de05e289554c9de049e7909bd3"}}
         :main-opts ["-m" "cognitect.test-runner"]}

  ;; kbb -M:render-console [out-file] -> docs/samples/lawyer-console.html
  ;; Drives the REAL actor stack; no invented numbers.
  :render-console {:main-opts ["-m" "lawfirm.render-console"]}}}
