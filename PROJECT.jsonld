              "description": "Handles case strategy, document review, and legal representation."
            },
            {
              "@id": "etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-svc-cofog-0310-us-fbi-ic3",
              "name": "FBI IC3 Crypto Reporter",
              "type": "Service",
              "cofog": "0310",
              "description": "Autonomous US crypto crime reporting."
            },
            {
              "@id": "etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-svc-cofog-0310-de-bka-cyber",
              "name": "Germany BKA Crypto Reporter",
              "type": "Service",
              "cofog": "0310",
              "description": "Autonomous Germany crypto crime reporting."
            },
            {
              "@id": "etzhayyim-performer-sys-etzhayyim-actors-pba7d22f-svc-cofog-0310-uk-action-fraud",
