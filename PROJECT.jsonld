      {
        "fileName": "uiux.jsonld",
        "content": {
          "@context": "https://schema.org/",
          "@type": "CreativeWork",
          "name": "Law Firm UI/UX Design",
          "description": "Integrated legal case management and document review interface.",
          "etzhayyim:designPrinciples": [
            "Clean, professional typography and layout",
            "Focus-mode for document review",
            "Secure communication indicators"
          ],
          "etzhayyim:uiComponents": [
            {
              "name": "Case Management Board",
              "type": "Board",
              "features": [
                "Active cases list",
                "Milestone tracking",
                "Deadlines calendar"
              ]
            },
            {
              "name": "Legal Document Center",
              "type": "DocumentViewer",
              "features": [
                "AI-summarized content",
                "Annotation tools",
                "Version history"
              ]
            }
          ],
          "etzhayyim:uxFlows": [
            {
              "name": "New Case Intake Flow",
              "steps": [
                "Register client",
                "Input case summary",
                "Upload initial documents",
                "Assign legal team"
              ]
            }
          ]
