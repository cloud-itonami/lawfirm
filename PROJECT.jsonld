      {
        "fileName": "measures.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "etzhayyim": "https://etzhayyim.com/schemas/"
          },
          "@type": "dodaf:Measure",
          "name": "Legal Service Performance Measures",
          "description": "Metrics and KPIs to evaluate the effectiveness of legal case management and AI automation.",
          "etzhayyim:measures": [
            {
              "id": "M-001",
              "name": "Drafting Accuracy",
              "metric": "Percentage of AI drafts requiring < 10% manual correction",
              "target": "95%",
              "category": "Quality"
            },
            {
              "id": "M-002",
              "name": "Intake Efficiency",
              "metric": "Average time from client inquiry to case record creation",
              "target": "< 1 hour",
              "category": "Operational"
            },
            {
              "id": "M-003",
              "name": "Response Time",
              "metric": "Average response time to client queries via portal",
              "target": "< 4 hours",
              "category": "Service"
            },
            {
              "id": "M-004",
              "name": "Cost Reduction",
              "metric": "Reduction in operational cost per case through automation",
              "target": "40%",
              "category": "Financial"
            }
          ]
        }
      },
      {
        "fileName": "rules.jsonld",
        "content": {
          "@context": {
            "dodaf": "http://dodcio.defense.gov/Library/DoDAF.aspx#",
            "etzhayyim": "https://etzhayyim.com/schemas/"
          },
          "@type": "dodaf:Rule",
          "name": "Legal Operations Rules",
          "description": "Operational rules governing legal services and AI integration.",
          "etzhayyim:rules": [
            {
              "id": "RULE-001",
              "name": "Attorney-Client Privilege",
              "description": "All client communications and case-related data must be encrypted and accessible only by authorized legal personnel.",
              "category": "Security"
            },
            {
              "id": "RULE-002",
              "name": "Data Sovereignty",
              "description": "Legal data must be stored in compliance with local jurisdiction regulations (e.g., APPI in Japan, IT Act in India).",
              "category": "Compliance"
            },
            {
              "id": "RULE-003",
              "name": "AI Verification",
              "description": "All AI-generated legal drafts must be reviewed and approved by a qualified lawyer (ISCO 2611) before finalization.",
              "category": "Quality"
            },
            {
              "id": "RULE-004",
              "name": "Audit Trail",
              "description": "Every action taken on a case record must be logged with a timestamp and the performer's identity.",
              "category": "Operational"
            }
          ]
        }
      },
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
              "etzhayyim": "https://etzhayyim.com/schemas/",
